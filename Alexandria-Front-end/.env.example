# Copy to .env and fill in the blanks. .env is gitignored — never commit it.
#
# Vite exposes ONLY variables prefixed with VITE_ to the browser bundle. Anything
# with that prefix is public: assume every user can read it in devtools. Anything
# without it stays on this machine and is available to node scripts only.

VITE_API_URL=http://localhost:3001/api

VITE_CHAIN_ID=84532
VITE_RPC_URL=https://sepolia.base.org

# Deployed addresses for Base Sepolia. Public by nature — they are on-chain.
VITE_TOKEN_CONTRACT_ADDRESS=0x99C8Ab3c870AAcD75185Ee2B0c96C0Cfe85Fd605
VITE_STAKE_CONTRACT_ADDRESS=0xe3027D298450695d9c4eD9A071D34e2921fc567C
VITE_LIBRARY_CONTRACT_ADDRESS=0x0b26AB8C632586E846DE87D29D665fd727bBe844
VITE_RENT_CONTRACT_ADDRESS=0xe50AD653Ee690c818900091a4d69F22e484bD2cD
VITE_PAYMENT_CONTRACT_ADDRESS=0xa5118F666C9A3F6FF1a8342Cd2FfC84134c8b1f8

VITE_ARWEAVE_GATEWAY=https://arweave.net

# ── Lit Protocol ────────────────────────────────────────────────────────────
# Without these two, src/services/lit.js sends an empty pkpId and no API key,
# and every decryption fails — for renters and librarians alike.
#
# The PKP id is a public identifier. The API key here is NOT secret in practice:
# it ships in the bundle, so anyone can read it and spend credits at $0.01 per
# Lit Action call. Use a key minted for this purpose, keep its balance small,
# and rotate it when it leaks — do not reuse the backend's upload key.
VITE_LIT_PKP_ID=
VITE_LIT_API_KEY=
# Optional; defaults to https://api.chipotle.litprotocol.com/core/v1
VITE_LIT_API_URL=

# Admin key for `npm run lit:register`, which permits the decryption Lit Action's
# IPFS CID against the PKP. No VITE_ prefix on purpose: it must never reach the
# bundle. The same value the backend uses in AlexNode/.env is fine here.
LIT_API_KEY=
# Optional; the action group the registered CID is added to (default 1).
LIT_GROUP_ID=
