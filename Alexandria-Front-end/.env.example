# Copy to .env and fill in the blanks. .env is gitignored — never commit it.
#
# Vite exposes ONLY variables prefixed with VITE_ to the browser bundle. Anything
# with that prefix is public: assume every user can read it in devtools. Anything
# without it stays on this machine and is available to node scripts only.

VITE_API_URL=http://localhost:3001/api

VITE_CHAIN_ID=84532
VITE_RPC_URL=https://sepolia.base.org

# Deployed addresses for Base Sepolia. Public by nature — they are on-chain.
VITE_TOKEN_CONTRACT_ADDRESS=0x99C8Ab3c870AAcD75185Ee2B0c96C0Cfe85Fd605
VITE_STAKE_CONTRACT_ADDRESS=0xe3027D298450695d9c4eD9A071D34e2921fc567C
VITE_LIBRARY_CONTRACT_ADDRESS=0x0b26AB8C632586E846DE87D29D665fd727bBe844
VITE_RENT_CONTRACT_ADDRESS=0xe50AD653Ee690c818900091a4d69F22e484bD2cD
VITE_PAYMENT_CONTRACT_ADDRESS=0xa5118F666C9A3F6FF1a8342Cd2FfC84134c8b1f8

# ── Lit Protocol ────────────────────────────────────────────────────────────
# Nothing Lit-related goes in the bundle. Books are unlocked through the backend
# relay (POST /api/rental/unlock), which holds the only key that can run the
# decryption Action, and the PKP id is a constant inside the Action itself
# (src/services/litAction.js). See AlexNode/KEY-BINDING.md, R4.

# `npm run lit:register -- --register` permits the decryption Lit Action's IPFS CID
# in the decrypt group. It asks for its key (the account key, or a usage key that
# can manage that group) at a hidden prompt. Never put that key in this file:
# the script refuses to run if LIT_API_KEY is set.
#
# Required for --register: the "Alexandria decrypt" group. Group 1 is the
# encryption group and is refused, so the decrypt Action can never land beside it.
LIT_GROUP_ID=
